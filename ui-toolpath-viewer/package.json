{
  "name": "camind-ui-toolpath-viewer",
  "version": "0.1.0",
  "description": "Compatibility bundle for the unified camind-ui-model-viewer; retains the legacy pure NC parser for regression checks.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "camind-ui-model-viewer"
      ]
    }
  }
}
