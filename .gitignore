# 系统 / 编辑器
.DS_Store
*.log

# 凭据与环境（模板除外）
.env
.env.*
!.env.example
!.env.sample
!.env.template

# dsh 数据目录（会话、上传、记忆库、settings/credentials）
.dsh/

# 依赖与构建产物
node_modules/

# cam_deliver 镜像进会话工作区的交付物（工作区恰为仓库根时兜底）
/delivery/
# tsc 误跑产生的编译残留（ui-shell web 由 vite 构建，ui-sidebar 由 ui-shell vite 打包；源码目录不应有 .js——且 .js 会抢在 .ts 前被解析）
ui-shell/src/**/*.js
ui-sidebar/src/**/*.js
ui-shell/vendor/**/src/**/*.js
