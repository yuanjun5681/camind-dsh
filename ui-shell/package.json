{
  "name": "camind-ui-shell",
  "version": "0.1.0",
  "description": "Independent customizable Web UI for DeepSeek Harness: Host protocol bridge + React SPA.",
  "type": "module",
  "main": "./dist/host/index.js",
  "exports": {
    ".": "./dist/host/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "scripts": {
    "prebuild": "node ../scripts/sync-dsh-version.mjs --check",
    "build": "tsc -p tsconfig.host.json && vite build",
    "predev": "node ../scripts/sync-dsh-version.mjs --check",
    "dev": "vite"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-client-modules": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-web": "0.1.1-rc.2",
    "@shikijs/langs": "^4.3.1",
    "@types/node": "^22.15.3",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "shiki": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
